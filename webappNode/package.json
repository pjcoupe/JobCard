{
  "name": "webapp-node",
  "version": "1.0.0",
  "description": "Backend API for the GeorgesWheel job card web app — reads and writes the same MongoDB 'wheel' database as the desktop app",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "mongodb": "^6.12.0",
    "sharp": "^0.35.3",
    "webapp-shared": "file:../webappShared"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.0"
  }
}
