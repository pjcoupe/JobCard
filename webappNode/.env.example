# Copy to .env and adjust as needed. All values shown are the defaults.
#
# PHOTO_ROOT, AUTH_SECRET, AUTH_PASSWORD_SHA256 and AUTH_USERNAME can also be set
# in the shared settings.settings document instead, using the same names in upper
# case. Anything set here wins over the database — see "Settings that can live in
# MongoDB instead" in README.md.

# MongoDB connection — the desktop app prompts for this host and uses port 27017.
MONGO_URL=mongodb://localhost:27017

# The wheel app targets the "wheel" database (DataAccess.connectMongoDb).
MONGO_DB=wheel

# Shared settings database (Xero / email config), separate from the job database.
MONGO_SETTINGS_DB=settings

# API listen port.
PORT=3000

# Comma-separated list of allowed browser origins for CORS.
# Behind Caddy the app is same-origin, so set this to the public hostname:
#   CORS_ORIGIN=https://jobcard.duckdns.org
CORS_ORIGIN=http://localhost:4200

# Signs session tokens. THE DEFAULT IS PUBLIC — anyone who knows it can forge a
# valid session. Set a long random value before exposing the app to the internet.
AUTH_SECRET=change-me-in-production

# The single allowed operator account.
AUTH_USERNAME=george

# Salted SHA-256 of the password. The default is public too; generate a new one:
#   node -e "const c=require('crypto');console.log(c.createHash('sha256').update('jobcard-wheel:'+process.argv[1]).digest('hex'))" 'the-new-password'
AUTH_PASSWORD_SHA256=

# Delay (ms) before a failed login is answered, so wrong credentials cannot be
# probed rapidly and the user gets clear feedback.
LOGIN_FAILURE_DELAY_MS=3000

# How long a session token stays valid (default 12 hours).
SESSION_TTL_MS=43200000

# Root of the shared photo drive the desktop app uses. The desktop default is
# K:\ (or D:\Kodak Pictures\ on the TCSP4 machine). This must be a path the API
# process itself can read and write — a drive letter on Windows, or the mount
# point of that same share on macOS/Linux, e.g. /Volumes/KodakPictures.
# On Windows, prefer the UNC path (\\WORKSHOPPC\Kodak Pictures) if the API runs
# as a service — see the mapped-drive section of README.md.
# Leave it unset to turn photos off; the rest of the app works without it.
PHOTO_ROOT=

# Largest photo or video upload accepted, in bytes (default 25 MB).
MAX_PHOTO_BYTES=26214400

# Also keep a copy of every new photo in the jobPictures collection, so photos
# survive the network share being unreachable.
PHOTO_BACKUP_ENABLED=true

# A photo is backed up untouched as long as its base64 form is at most this big;
# only larger ones get recompressed (default 14 MB, well under Mongo's 16 MB cap).
PHOTO_BACKUP_COMPRESS_THRESHOLD_BYTES=14680064
